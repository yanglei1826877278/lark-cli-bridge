# 第一次本地测试不填，默认使用 http://127.0.0.1:8765
PUBLIC_URL=http://127.0.0.1:8765
HOST=127.0.0.1
PORT=8765
# 至少 16 位、随机且仅自己知道的密码。OAuth 登录界面需要输入它
OWNER_PASSWORD=replace-with-a-strong-random-password
# mock 只用于本地测试。准备真实读写时必须改为 0
MOCK_CLI=1
# restricted：只暴露固定工具；full：允许在 OAuth 页面选择完全权限并使用 run_lark_cli
BRIDGE_PERMISSION_MODE=restricted
# 真实 CLI 可执行文件，可用 where lark-cli 查询；留空则自动查找
LARK_CLI_PATH=
# 逗号分隔。为避免误写其他表，仅允许这些多维表格 base token
ALLOWED_BASE_TOKENS=
# 逗号分隔。只允许这些文档 token 或 URL 的最后路径 token
ALLOWED_DOC_TOKENS=
# 服务端数据库位置
DB_PATH=data/bridge.sqlite3
# 限制单次 CLI 调用时长（秒）
CLI_TIMEOUT=25
# CLI 读写本地文件的工作目录；Docker Compose 会覆盖为 /workspace
CLI_WORKDIR=.
